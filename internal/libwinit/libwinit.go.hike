type EventReceivedCharacter struct {
	Length uint64
	Byte1  uint8
	Byte2  uint8
	Byte3  uint8
	Byte4  uint8
}

type WindowResizedEvent struct {
	Width  uint32
	Height uint32
}

type WindowScaleFactorChangedEvent struct {
	ScaleFactor float64
	Width       uint32
	Height      uint32
}

type WindowMovedEvent struct {
	X int32
	Y int32
}

type WindowFocusedEvent struct {
	IsFocused bool
}

type WindowOccludedEvent struct {
	IsOccluded bool
}

type EventModifiersState struct {
	Shift bool
	Ctrl  bool
	Alt   bool
	Logo  bool
}

type EventUserEvent struct {
	Event UserEvent
}

type Event struct {
	WindowID       U128
	EventType      EventType
	Touch          TouchEvent
	MouseWheel     MouseWheelEvent
	MouseInput     MouseInputEvent
	CursorMoved    CursorMovedEvent
	KeyboardInput  EventKeyboardInput
	ReceivedCharacter EventReceivedCharacter
	WindowResized  WindowResizedEvent
	ScaleFactor    WindowScaleFactorChangedEvent
	WindowMoved    WindowMovedEvent
	WindowFocused  WindowFocusedEvent
	WindowOccluded WindowOccludedEvent
	Modifiers      EventModifiersState
	UserEvent      EventUserEvent
}

type SizeU32 struct {
	Width  uint32
	Height uint32
}

type PointBoxI32 struct {
	X int32
	Y int32
}

// ValueBox output records used by the get-size, get-position and get-id APIs.
// The tag is zero for the inline value variant; Value is the native pointer
// held by the C union.
type ValueBoxSizeBoxU32 struct {
	Tag   uint8
	Value uintptr
}

type ValueBoxPointBoxI32 struct {
	Tag   uint8
	Value uintptr
}

type U128Box struct {
	Tag   uint8
	Value uintptr
}

// Raw handles, value-boxes, StringBox, EventLoop, Window and WindowAttributes
// are opaque C records. Keep their declarations as byte pointers so Hike does
// not reinterpret Rust-owned memory.
