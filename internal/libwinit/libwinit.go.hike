// libwinit C ABI declarations for Hike.
//
// This file mirrors third_party/libwinit/winit.h. Opaque Rust/value-box
// handles and callback pointers are represented as *byte, matching the Hike
// native bindings convention used by the wgpu-static bridge.
package libwinit

// C enum and scalar mappings used by winit.h:
//   - WinitEventLoopType: uint8
//   - WinitControlFlow and event/user/cursor enums: uint32
//   - size_t: uint64
//   - unsigned long: uint32 on Windows
//   - double: float64
//   - opaque pointers and function pointers: *byte

type EventLoopType uint8

const (
	EventLoopTypeWindows EventLoopType = iota
	EventLoopTypeMacOS
	EventLoopTypeX11
	EventLoopTypeWayland
	EventLoopTypeUnknown
)

type ControlFlow uint32

const (
	ControlFlowPoll ControlFlow = iota
	ControlFlowWait
	ControlFlowExit
)

type EventType uint32

const (
	EventTypeUnknown EventType = iota
	EventTypeWindowEventResized
	EventTypeWindowEventMoved
	EventTypeWindowEventCloseRequested
	EventTypeWindowEventDestroyed
	EventTypeWindowEventDroppedFile
	EventTypeWindowEventHoveredFile
	EventTypeWindowEventHoveredFileCancelled
	EventTypeWindowEventReceivedCharacter
	EventTypeWindowEventFocused
	EventTypeWindowEventKeyboardInput
	EventTypeWindowEventCursorMoved
	EventTypeWindowEventCursorEntered
	EventTypeWindowEventCursorLeft
	EventTypeWindowEventMouseWheel
	EventTypeWindowEventMouseInput
	EventTypeWindowEventTouchpadPressure
	EventTypeWindowEventAxisMotion
	EventTypeWindowEventTouch
	EventTypeWindowEventScaleFactorChanged
	EventTypeNewEvents
	EventTypeMainEventsCleared
	EventTypeLoopDestroyed
	EventTypeSuspended
	EventTypeResumed
	EventTypeRedrawRequested
	EventTypeRedrawEventsCleared
	EventTypeModifiersChanged
	EventTypeUserEvent
	EventTypeWindowEventOccluded
)

type EventTouchPhase uint32

const (
	EventTouchPhaseUnknown EventTouchPhase = iota
	EventTouchPhaseStarted
	EventTouchPhaseMoved
	EventTouchPhaseEnded
	EventTouchPhaseCancelled
)

type EventMouseScrollDeltaType uint32

const (
	EventMouseScrollDeltaTypeUnknown EventMouseScrollDeltaType = iota
	EventMouseScrollDeltaTypeLineDelta
	EventMouseScrollDeltaTypePixelDelta
)

type EventInputElementState uint32

const (
	EventInputElementStateUnknown EventInputElementState = iota
	EventInputElementStatePressed
	EventInputElementStateReleased
)

type EventMouseButtonType uint32

const (
	EventMouseButtonTypeUnknown EventMouseButtonType = iota
	EventMouseButtonTypeLeft
	EventMouseButtonTypeRight
	EventMouseButtonTypeMiddle
	EventMouseButtonTypeOther
)

type UserEvent uint32

const (
	UserEventWakeUp UserEvent = iota
	UserEventExit
)

type CursorIcon uint32

const (
	CursorIconDefault CursorIcon = iota
	CursorIconCrosshair
	CursorIconHand
	CursorIconArrow
	CursorIconMove
	CursorIconText
	CursorIconWait
	CursorIconHelp
	CursorIconProgress
	CursorIconNotAllowed
	CursorIconContextMenu
	CursorIconCell
	CursorIconVerticalText
	CursorIconAlias
	CursorIconCopy
	CursorIconNoDrop
	CursorIconGrab
	CursorIconGrabbing
	CursorIconAllScroll
	CursorIconZoomIn
	CursorIconZoomOut
	CursorIconEResize
	CursorIconNResize
	CursorIconNeResize
	CursorIconNwResize
	CursorIconSResize
	CursorIconSeResize
	CursorIconSwResize
	CursorIconWResize
	CursorIconEwResize
	CursorIconNsResize
	CursorIconNeswResize
	CursorIconNwseResize
	CursorIconColResize
	CursorIconRowResize
)

// Public value layouts from winit.h. Pointer-bearing members remain opaque;
// callers normally pass these records through *byte to native entry points.
type U128 struct {
	High uint64
	Low  uint64
}

type TouchEvent struct {
	DeviceID int64
	Phase    EventTouchPhase
	X        float64
	Y        float64
	ID       uint64
}

type MouseScrollDelta struct {
	DeltaType EventMouseScrollDeltaType
	X         float64
	Y         float64
}

type MouseWheelEvent struct {
	DeviceID int64
	Phase    EventTouchPhase
	Delta    MouseScrollDelta
}

type EventMouseButton struct {
	ButtonType EventMouseButtonType
	ButtonCode uint16
}

type MouseInputEvent struct {
	DeviceID int64
	State    EventInputElementState
	Button   EventMouseButton
}

type CursorMovedEvent struct {
	DeviceID int64
	X        float64
	Y        float64
}

type EventKeyboardInput struct {
