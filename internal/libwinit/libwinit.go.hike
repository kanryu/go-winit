// Native callback implementations. These are deliberately small, safe
// defaults: callers can pass their thunk through the data argument and use the
// generated callback pointers when registering with libwinit.
cfunc c_EventLoopRunDataCallback(data *byte, event *Event) uint32 {
	if event.EventType == EventTypeWindowEventCloseRequested {
		if data != nil {
			winit_window_drop(data)
		}
		return uint32(2) // WinitControlFlow_Exit
	}
	return uint32(1) // WinitControlFlow_Wait
}

cfunc EventLoopRunDataCallback(data *byte, event *Event) uint32 = c_EventLoopRunDataCallback

cfunc c_EventLoopRunReturnCallback(event *Event) uint32 {
	if event.EventType == EventTypeWindowEventCloseRequested {
		return uint32(2) // WinitControlFlow_Exit
	}
	return uint32(1) // WinitControlFlow_Wait
}

cfunc EventLoopRunReturnCallback(event *Event) uint32 = c_EventLoopRunReturnCallback

cfunc c_PollingSemaphoreCallback(index uint64, thunk *byte) {
}

cfunc PollingSemaphoreCallback(index uint64, thunk *byte) = c_PollingSemaphoreCallback

cfunc c_PollingMainEventsCallback(thunk *byte) {
}

cfunc PollingMainEventsCallback(thunk *byte) = c_PollingMainEventsCallback

cfunc c_PollingResizeCallback(thunk *byte, width uint32, height uint32) {
}

cfunc PollingResizeCallback(thunk *byte, width uint32, height uint32) = c_PollingResizeCallback

cfunc c_PollingRedrawCallback(thunk *byte) {
}

cfunc PollingRedrawCallback(thunk *byte) = c_PollingRedrawCallback

// Keeps the generated Go package's aggregate ABI path alive. HikeC emits a
// runtime.KeepAlive call for this record argument, which is also required by
// the pointer-bearing event callback records above.
cfunc KeepAliveEvent(event Event) {
}

// Callback pointer accessors follow the same pattern as the wgpu-static Hike
// bridge. The returned uintptr is the address of a native ABI-compatible
// trampoline and can be supplied to the callback *byte parameters above.
extern func EventLoopRunDataCallbackPtr() uintptr = EventLoopRunDataCallback
extern func EventLoopRunReturnCallbackPtr() uintptr = EventLoopRunReturnCallback
extern func PollingSemaphoreCallbackPtr() uintptr = PollingSemaphoreCallback
extern func PollingMainEventsCallbackPtr() uintptr = PollingMainEventsCallback
extern func PollingResizeCallbackPtr() uintptr = PollingResizeCallback
extern func PollingRedrawCallbackPtr() uintptr = PollingRedrawCallback

// Go-facing aliases. These preserve the exact native symbol names above while
// exposing idiomatic Hike names for generated callers.
cfunc BoxerStringFromByteString(data *byte, length uint64) *byte = boxer_string_from_byte_string
cfunc BoxerStringDrop(stringBox *byte) = boxer_string_drop

